# Copy to .env.local and fill in. Everything here is optional; without it the app runs,
# but verification and password-reset codes are written to the server console and to
# data/outbox/mail.log instead of being emailed.

# --- Sending mail -----------------------------------------------------------
# Resend is tried first when RESEND_API_KEY is set; it needs nothing but a network call.
RESEND_API_KEY=
# Must be an address on a domain verified in the Resend dashboard.
RESEND_FROM_EMAIL=hello@example.com
# Optional. When set, every message goes here instead of the real recipient — handy
# while testing against one real inbox. Remove it before the team uses the app.
# RESEND_TO_EMAIL=hello@example.com

# Or plain SMTP, used when RESEND_API_KEY is absent. Any account will do: a Gmail app
# password, Fastmail, Postmark, your host.
SMTP_HOST=smtp.example.com
# 587 starts plain and upgrades with STARTTLS; 465 is TLS from the first byte.
SMTP_PORT=587
SMTP_USER=no-reply@example.com
SMTP_PASS=
# Set to true only if you are on 465 and it is not being inferred.
# SMTP_SECURE=true
# What recipients see in the From line. Defaults to SMTP_USER.
MAIL_FROM="Standup <no-reply@example.com>"

# --- Storage ----------------------------------------------------------------
# Defaults to data/standup.db. Point tests and throwaway servers somewhere else so they
# cannot write to the real one.
# STANDUP_DB_FILE=/tmp/standup-dev.db
# DELETE keeps the database a single copyable file; WAL is right once it is deployed.
# STANDUP_JOURNAL_MODE=WAL
